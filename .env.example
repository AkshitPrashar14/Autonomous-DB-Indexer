# ============================================================
# DBAutonomy — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# ----------------------------
# AI Configuration
# ----------------------------
# Mode can be 'real' or 'mock'
AI_MODE=real

# Gemini API Key for index candidate generation
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model version to use
GEMINI_MODEL=gemini-2.5-flash

# (Optional) Groq fallback configuration
GROQ_API_KEY=

# ----------------------------
# Primary Database
# ----------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dbautonomy_primary
DB_USER=dbautonomy
DB_PASSWORD=dbautonomy

# ----------------------------
# Shadow Database
# ----------------------------
# Host for the shadow database
SHADOW_DB_HOST=localhost
# Port for the shadow database
SHADOW_DB_PORT=5433
SHADOW_DB_NAME=dbautonomy_shadow
SHADOW_DB_USER=dbautonomy
SHADOW_DB_PASSWORD=dbautonomy

# ----------------------------
# Redis
# ----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ----------------------------
# Ollama (Local AI)
# ----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_S=30

# ----------------------------
# Safety Gate
# ----------------------------
# Comma-separated list of tables that may be indexed.
# Empty = no tables are allowed (fail-safe default).
SAFETY_ALLOWED_TABLES=orders,products,events
SAFETY_MIN_REWARD_THRESHOLD=0.05
SAFETY_MAX_WRITE_REGRESSION=0.10

# ----------------------------
# Agent Behaviour
# ----------------------------
AGENT_MAX_RETRIES=3
AGENT_BENCHMARK_ITERATIONS=10
BENCHMARK_WRITE_IMPACT=true

# ----------------------------
# Bandit (LinUCB)
# ----------------------------
BANDIT_ALPHA=1.0
BANDIT_CONTEXT_DIM=20

# ----------------------------
# Log Monitor
# ----------------------------
LOG_MONITOR_SLOW_THRESHOLD_MS=500
LOG_MONITOR_POLL_INTERVAL_S=10
LOG_MONITOR_SOURCE=pg_stat_statements

# ----------------------------
# Application
# ----------------------------
LOG_LEVEL=INFO
APP_ENV=development
DEBUG=false

# ----------------------------
# Demo Configuration
# ----------------------------
# If true, the system restricts modifications to specific tables for safe demonstrations
DEMO_MODE=true
# Controls the dataset size (small or large)
DEMO_SCALE=large
